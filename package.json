{
  "name": "rift-launcher",
  "version": "0.3.3",
  "private": true,
  "description": "AI-native quick launcher (MVP) — Electron + React + TS",
  "author": {
    "name": "Haoze Li",
    "email": "lihaozecq@gmail.com"
  },
  "homepage": "https://github.com/lhz960904/rift-launcher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhz960904/rift-launcher.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "dist:publish": "electron-vite build && electron-builder --mac --publish always"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.3",
    "plist": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/plist": "^3.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
