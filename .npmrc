# electron-builder packs node_modules into app.asar by walking the flat
# layout. pnpm's default isolated/symlinked layout hides transitive deps
# from the walker (e.g. chokidar → glob-parent → is-glob → is-extglob),
# causing "Cannot find module" crashes at runtime. node-linker=hoisted
# makes pnpm install the npm-style flat tree so every transitive dep is
# directly visible at node_modules/<pkg>.
node-linker=hoisted
